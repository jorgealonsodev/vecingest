# syntax=docker/dockerfile:1.7
#
# Builds the Expo web export (app/) and serves the static output through
# nginx-unprivileged on port 8080 (D-K): the official nginx image starts
# as root and fails PRD §10.1's non-root container gate, so Nginx Proxy
# Manager must target 8080, not 80.
#
# app/'s real Expo Router source and `expo export -p web` build lands in
# Phase 10; until then `pnpm --filter app build` writes a placeholder
# dist/index.html so this Dockerfile is buildable and verifiable today
# (task 8.3) without pre-empting Phase 10's own scope.
#
# Build (from the repository root):
#   docker build -f app/Dockerfile.web -t vecingest-web .

FROM node:22-slim AS deps
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
WORKDIR /workspace
COPY pnpm-workspace.yaml turbo.json package.json pnpm-lock.yaml ./
COPY app/package.json ./app/package.json
COPY packages/shared/package.json ./packages/shared/package.json
COPY site/package.json ./site/package.json
RUN pnpm install --frozen-lockfile

FROM deps AS build
COPY api/openapi ./api/openapi
COPY packages/shared ./packages/shared
COPY app ./app
RUN pnpm --filter @vecingest/shared build
# Expo inlines EXPO_PUBLIC_* variables into the static bundle at build
# time (there is no runtime env var to change after the image exists).
# In CI this came from a GitHub Actions secret passed as --build-arg; on
# the server, docker-compose.yml's `web.build.args` passes it from the
# stack's own environment instead (see env.example).
ARG EXPO_PUBLIC_API_URL
ENV EXPO_PUBLIC_API_URL=${EXPO_PUBLIC_API_URL}
RUN pnpm --filter app build

FROM nginxinc/nginx-unprivileged:1.30-alpine
COPY --from=build /workspace/app/dist /usr/share/nginx/html
COPY app/nginx.conf /etc/nginx/conf.d/default.conf
USER 1000:1000
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD ["wget", "-qO-", "http://127.0.0.1:8080/"]
