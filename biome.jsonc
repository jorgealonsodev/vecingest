{
	"$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			// Build/tooling output. `vcs.useIgnoreFile` already skips most of these
			// via .gitignore, but they are listed explicitly per project policy so
			// the exclusion does not silently depend on VCS state.
			"!**/node_modules",
			"!**/dist",
			"!**/.expo",
			"!**/.turbo",
			"!app/dist",
			// Generated by `make gen`: Go structs -> huma -> api/openapi/openapi.yaml
			// -> openapi-typescript/openapi-zod-client -> these files, driven by
			// packages/shared/scripts/generate.mjs. CI has a dirty-diff gate that
			// fails if regenerating changes them, so Biome must never reformat or
			// flag them -- doing so would fight that gate on every `make gen` run.
			// src/index.ts is ALSO generated (generateBarrel() in generate.mjs
			// writes it verbatim, with its own "GENERATED FILE -- DO NOT EDIT"
			// header, in a fixed client/schemas/errors export order that Biome's
			// organizeImports assist would otherwise "fix" to alphabetical order
			// on every run -- excluded for the same dirty-diff reason as
			// src/client/ and src/schemas/. Only src/errors.ts is genuinely
			// hand-written in this package and stays covered by lint/format.
			"!packages/shared/src/client",
			"!packages/shared/src/schemas",
			"!packages/shared/src/index.ts"
		]
	},
	"formatter": {
		"enabled": true,
		// Matches the indentation already used across app/ and packages/shared/
		// (2-space, not Biome's own default of tabs). Set explicitly so `biome
		// check` reports real findings instead of reformatting every existing
		// file to a style the codebase never used.
		"indentStyle": "space",
		"indentWidth": 2
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
